# 環境變數範本 —— 🔴 只列變數名與非敏感示意值,真實 secret 絕不進 git。
# 複製成 .env 後填入實值;缺任何一個必填變數,服務會直接啟動失敗(fail-fast)。

# --- 服務識別 ---
SERVICE_NAME=upload-program
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- 對外位置(Cats 平台單一入口 + 路徑前綴)---
# ✅ API_PREFIX 由平台方分配,不得自選。portal 裁決函(2026-07-29)已定案 `/upload/`。
PUBLIC_BASE_URL=https://catsapp.sporton.com.tw
API_PREFIX=/upload

# --- 資料庫(容器內走 service name,不寫死 IP)---
# 命名依平台規約命名表(<service>_db / <service>_user,service 取 `upload-program`):
# 尚未上線、無正式資料,現在改比上線後改便宜(portal 施工單 2026-07-29 §6)。
DB_NAME=upload_program_db
DB_USER=upload_program_user
DB_PASSWORD=
DATABASE_URL=postgresql+asyncpg://upload_program_user:CHANGE_ME@db:5432/upload_program_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# --- OIDC / Keycloak ---
# 預設:只填 issuer,其餘端點從 discovery 動態取。
# 🔴 但在正式 VM(施工單 v1.3 §4.4):容器內連對外網址不通,且 discovery 裡的
#    端點全是對外網址——**伺服器端呼叫**請用下面三個內部位址覆寫(T60)。
# ⏳ client_id / secret 走 SSO 契約 §5 向 portal 申請後填入。
# 🔴 D2″(2026-07-27)之後 IdP 掛在**子路徑**下,不是獨立網域:
#    IdP 與各 App 因此**同源**,見 SSO 契約 §4.10 的額外義務。
OIDC_ISSUER=https://catsapp.sporton.com.tw/auth/realms/sporton
OIDC_CLIENT_ID=upload-program
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
# 留空即自動組成 ${PUBLIC_BASE_URL}${API_PREFIX}/oidc/callback/
OIDC_REDIRECT_URI_OVERRIDE=
# --- T60 伺服器端內部位址覆寫(留空 = 照舊從 issuer/discovery 推導)---
# 🔴 只覆寫伺服器發出的請求;OIDC_ISSUER 與瀏覽器端點永遠維持對外
#    (iss 是字串比對不是連線)。VM 目標值(cats-edge 內部):
#    OIDC_DISCOVERY_URL=http://keycloak:8080/auth/realms/sporton/.well-known/openid-configuration
#    OIDC_TOKEN_URL=http://keycloak:8080/auth/realms/sporton/protocol/openid-connect/token
#    OIDC_JWKS_URL=http://keycloak:8080/auth/realms/sporton/protocol/openid-connect/certs
OIDC_DISCOVERY_URL=
OIDC_TOKEN_URL=
OIDC_JWKS_URL=
# 平台層短網址(契約 §2.1),由 gateway 302 轉址。**刻意不帶本服務的前綴**
# ——它是平台的東西,不是我們的路由。
ACCOUNT_CONSOLE_URL=/account
JWKS_CACHE_SECONDS=3600
CLOCK_SKEW_SECONDS=30

# --- session cookie(簽章用,非 JWT 金鑰)---
# 產生方式:python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_COOKIE_NAME=upload_session
SESSION_COOKIE_SECURE=true
SESSION_MAX_AGE_SECONDS=36000

# 首批平台管理員的 Keycloak sub(逗號分隔);首登即 active + admin,
# 用來解「沒人能開通第一個人」的雞生蛋問題。上線後應清空。
BOOTSTRAP_ADMIN_SUBS=

# --- 物件儲存(MinIO,只在 backend 網路內可達)---
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=upload-artifacts
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_MULTIPART_CHUNK_BYTES=16777216

# --- 上傳限制 ---
# 🔴 gateway 的 client_max_body_size 必須 ≥ MAX_ARTIFACT_BYTES(建議 128 MB 留餘裕),
#    申請路由時一併提出。
# 這三個值必須與 app/config.py 的預設一致 —— 有測試在擋(test_env_example的容量值與程式預設一致)。
# 專案容量分兩級距(F17/T49):專案列上只存級距代號,對應的位元組數就是下面這兩個設定值,
# 所以調整級距不必動任何一列資料。誰能改級距:只有平台管理員。
MAX_ARTIFACT_BYTES=104857600      # 100 MB(單檔上限)
MAX_PROJECT_BYTES=2147483648      # 2 GB(專案 standard 級距,預設)
MAX_PROJECT_EXTENDED_BYTES=10737418240   # 10 GB(專案 extended 級距,需管理員核可)

# --- 稽核紀錄(F54)---
# 保留幾天。⚠️ 本服務**沒有排程器**,這個值不會自己生效 ——
# 由 `tools/purge_audit.py` 搭配 VM 的 cron(或人工)執行,例如每日一次:
#   0 4 * * *  cd /srv/upload-program && .venv/bin/python tools/purge_audit.py --apply
AUDIT_RETENTION_DAYS=365

# --- 其他 ---
PROBLEM_TYPE_BASE=https://catsapp.sporton.com.tw/errors
