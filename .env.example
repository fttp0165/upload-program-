# 環境變數範本 —— 🔴 只列變數名與非敏感示意值,真實 secret 絕不進 git。
# 複製成 .env 後填入實值;缺任何一個必填變數,服務會直接啟動失敗(fail-fast)。

# --- 服務識別 ---
SERVICE_NAME=upload-program
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- 對外位置(Cats 平台單一入口 + 路徑前綴)---
# ⏳ API_PREFIX 由平台方分配,不得自選。
PUBLIC_BASE_URL=https://catsapp.sporton.com.tw
API_PREFIX=/upload

# --- 資料庫(容器內走 service name,不寫死 IP)---
DB_NAME=upload_db
DB_USER=upload_user
DB_PASSWORD=
DATABASE_URL=postgresql+asyncpg://upload_user:CHANGE_ME@db:5432/upload_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# --- OIDC / Keycloak ---
# 只填 issuer:其餘端點一律從 discovery 動態取,不寫死路徑。
# ⏳ client_id / secret 走 SSO 契約 §5 向 portal 申請後填入。
OIDC_ISSUER=https://auth.sporton.com.tw/realms/sporton
OIDC_CLIENT_ID=upload-program
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
# 留空即自動組成 ${PUBLIC_BASE_URL}${API_PREFIX}/oidc/callback/
OIDC_REDIRECT_URI_OVERRIDE=
JWKS_CACHE_SECONDS=3600
CLOCK_SKEW_SECONDS=30

# --- session cookie(簽章用,非 JWT 金鑰)---
# 產生方式:python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_COOKIE_NAME=upload_session
SESSION_COOKIE_SECURE=true
SESSION_MAX_AGE_SECONDS=36000

# 首批平台管理員的 Keycloak sub(逗號分隔);首登即 active + admin,
# 用來解「沒人能開通第一個人」的雞生蛋問題。上線後應清空。
BOOTSTRAP_ADMIN_SUBS=

# --- 物件儲存(MinIO,只在 backend 網路內可達)---
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=upload-artifacts
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_MULTIPART_CHUNK_BYTES=16777216

# --- 上傳限制 ---
# 🔴 gateway 的 client_max_body_size 必須 ≥ MAX_ARTIFACT_BYTES,申請路由時一併提出。
MAX_ARTIFACT_BYTES=536870912
MAX_PROJECT_BYTES=5368709120

# --- 其他 ---
PROBLEM_TYPE_BASE=https://catsapp.sporton.com.tw/errors
